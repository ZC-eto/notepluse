{
  "$schema": "../node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "notepluse",
  "title": "诺麦笔记",
  "description": "本地 Markdown 笔记与任务：文件夹 · 待办 · 甘特 · 日历",
  "author": "zebra",
  "version": "0.9.1",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true
  },
  "features": [
    {
      "code": "workspace",
      "explain": "打开诺麦笔记",
      "icon": "logo.png",
      "cmds": [
        "md",
        "笔记",
        "markdown",
        "诺麦笔记",
        "诺麦",
        "notepluse",
        "NotePluse"
      ]
    },
    {
      "code": "todo",
      "explain": "打开待办投影",
      "icon": "logo.png",
      "cmds": [
        "todo",
        "待办"
      ]
    },
    {
      "code": "gantt",
      "explain": "打开甘特投影（仅含排期任务）",
      "icon": "logo.png",
      "cmds": [
        "gantt",
        "甘特"
      ]
    },
    {
      "code": "calendar",
      "explain": "打开日历投影（仅含排期任务）",
      "icon": "logo.png",
      "cmds": [
        "日历",
        "calendar"
      ]
    },
    {
      "code": "open-file",
      "explain": "用诺麦笔记打开 Markdown 文件",
      "icon": "logo.png",
      "cmds": [
        {
          "type": "files",
          "fileType": "file",
          "maxLength": 1,
          "extensions": [
            "md",
            "markdown"
          ],
          "label": "用诺麦笔记打开"
        }
      ]
    }
  ],
  "development": {
    "main": "http://localhost:5173"
  }
}
